                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();
                const pages = ['page-1', 'page-2', 'page-3', 'page-4', 'page-5', 'page-6', 'page-7', 'page-8', 'page-9'];

                // İlerleme göstergesi
                let currentPage = 0;
                const totalPages = pages.length;

                function processNextPage() {
                    if (currentPage < totalPages) {
                        const pageElement = document.getElementById(pages[currentPage]);

                        html2canvas(pageElement, {
                            scale: 1,
                            useCORS: true,
                            logging: true
                        }).then(function(canvas) {
                            const imgData = canvas.toDataURL('image/png');

                            if (currentPage > 0) {
                                doc.addPage();
                            }

                            const pageWidth = doc.internal.pageSize.getWidth();
                            const pageHeight = doc.internal.pageSize.getHeight();
                            const imgHeight = canvas.height * pageWidth / canvas.width;

                            doc.addImage(imgData, 'PNG', 0, 0, pageWidth, imgHeight);

                            currentPage++;
                            processNextPage();
                        });
                    } else {
                        // Tüm sayfalar işlendikten sonra PDF'i indir
                        doc.save('Algo_Report.pdf');
                    }
                }

                // İşlemi başlat
                processNextPage();
            }

            // Download butonuna tıklama olayını ekle
            const downloadButton = document.getElementById('download-invoice');
            if (downloadButton) {
                downloadButton.addEventListener('click', downloadPDF);
            } else {
                console.error("Download button not found!");
            }
        };
    </script>
