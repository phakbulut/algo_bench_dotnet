@{
    var allData = (Dictionary<string, dynamic>)ViewBag.AllData;

 
}
@model List<algo.ViewModels.AlgorithmReportViewModel>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sorting Algorithms Detailed Report</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">


</head>

<body class="bg-light">

    <div id="page-1">

        <div class="container my-5">
            <h1 class="text-center mb-4">Sorting Algorithms Detailed Performance Report</h1>
            <p class="text-muted text-center">
                This report compares theoretical and experimental performance of sorting algorithms under different
                array
                configurations.
            </p>
            <div class="table-responsive">
                <div class="tabs">
                    <!-- Tab Menüsü -->
                    <ul class="nav nav-tabs" id="arrayTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" id="tab-1k" data-bs-toggle="tab" href="#array-1k" role="tab" aria-controls="array-1k" aria-selected="true">1K</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="tab-10k" data-bs-toggle="tab" href="#array-10k" role="tab" aria-controls="array-10k" aria-selected="false">10K</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="tab-100k" data-bs-toggle="tab" href="#array-100k" role="tab" aria-controls="array-100k" aria-selected="false">100K</a>
                        </li>
                    </ul>

                    <!-- Tab İçerikleri -->
                    <div class="tab-content mt-3" id="arrayTabsContent">
                        <div class="tab-pane fade show active" id="array-1k" role="tabpanel" aria-labelledby="tab-1k">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped text-center">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Algorithm</th>
                                            <th>Array Type</th>
                                            <th>Execution Count</th>
                                            <th>Theoretical Best Case</th>
                                            <th>Theoretical Average Case</th>
                                            <th>Theoretical Worst Case</th>
                                            <th>Average Time (ms)</th>
                                            <th>Best Time (ms)</th>
                                            <th>Worst Time (ms)</th>
                                            <th>Average Memory (MB)</th>
                                            <th>Best Memory (MB)</th>
                                            <th>Worst Memory (MB)</th>
                                            <th>Average CPU (%)</th>
                                            <th>Best CPU (%)</th>
                                            <th>Worst CPU (%)</th>
                                            <th>Invalid Measurements</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(m => m.ArraySize == "1000"))
                                        {
                                            <tr>
                                                <td>@item.Algorithm</td>
                                                <td>@item.ArrayType</td>
                                                <td>@item.ExecutionCount</td>
                                                <td>@item.TheoreticalBestCase</td>
                                                <td>@item.TheoreticalAverageCase</td>
                                                <td>@item.TheoreticalWorstCase</td>
                                                <td>@item.AverageTime</td>
                                                <td>@item.BestTime</td>
                                                <td>@item.WorstTime</td>
                                                <td>@item.AverageMemory</td>
                                                <td>@item.BestMemory</td>
                                                <td>@item.WorstMemory</td>
                                                <td>@item.AverageCpu</td>
                                                <td>@item.BestCpu</td>
                                                <td>@item.WorstCpu</td>
                                                <td>@item.InvalidMeasurementCount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="array-10k" role="tabpanel" aria-labelledby="tab-10k">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped text-center">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Algorithm</th>
                                            <th>Array Type</th>
                                            <th>Execution Count</th>
                                            <th>Theoretical Best Case</th>
                                            <th>Theoretical Average Case</th>
                                            <th>Theoretical Worst Case</th>
                                            <th>Average Time (ms)</th>
                                            <th>Best Time (ms)</th>
                                            <th>Worst Time (ms)</th>
                                            <th>Average Memory (MB)</th>
                                            <th>Best Memory (MB)</th>
                                            <th>Worst Memory (MB)</th>
                                            <th>Average CPU (%)</th>
                                            <th>Best CPU (%)</th>
                                            <th>Worst CPU (%)</th>
                                            <th>Invalid Measurements</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(m => m.ArraySize == "10000"))
                                        {
                                            <tr>
                                                <td>@item.Algorithm</td>
                                                <td>@item.ArrayType</td>
                                                <td>@item.ExecutionCount</td>
                                                <td>@item.TheoreticalBestCase</td>
                                                <td>@item.TheoreticalAverageCase</td>
                                                <td>@item.TheoreticalWorstCase</td>
                                                <td>@item.AverageTime</td>
                                                <td>@item.BestTime</td>
                                                <td>@item.WorstTime</td>
                                                <td>@item.AverageMemory</td>
                                                <td>@item.BestMemory</td>
                                                <td>@item.WorstMemory</td>
                                                <td>@item.AverageCpu</td>
                                                <td>@item.BestCpu</td>
                                                <td>@item.WorstCpu</td>
                                                <td>@item.InvalidMeasurementCount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="array-100k" role="tabpanel" aria-labelledby="tab-100k">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped text-center">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Algorithm</th>
                                            <th>Array Type</th>
                                            <th>Execution Count</th>
                                            <th>Theoretical Best Case</th>
                                            <th>Theoretical Average Case</th>
                                            <th>Theoretical Worst Case</th>
                                            <th>Average Time (ms)</th>
                                            <th>Best Time (ms)</th>
                                            <th>Worst Time (ms)</th>
                                            <th>Average Memory (MB)</th>
                                            <th>Best Memory (MB)</th>
                                            <th>Worst Memory (MB)</th>
                                            <th>Average CPU (%)</th>
                                            <th>Best CPU (%)</th>
                                            <th>Worst CPU (%)</th>
                                            <th>Invalid Measurements</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Where(m => m.ArraySize == "100000"))
                                        {
                                            <tr>
                                                <td>@item.Algorithm</td>
                                                <td>@item.ArrayType</td>
                                                <td>@item.ExecutionCount</td>
                                                <td>@item.TheoreticalBestCase</td>
                                                <td>@item.TheoreticalAverageCase</td>
                                                <td>@item.TheoreticalWorstCase</td>
                                                <td>@item.AverageTime</td>
                                                <td>@item.BestTime</td>
                                                <td>@item.WorstTime</td>
                                                <td>@item.AverageMemory</td>
                                                <td>@item.BestMemory</td>
                                                <td>@item.WorstMemory</td>
                                                <td>@item.AverageCpu</td>
                                                <td>@item.BestCpu</td>
                                                <td>@item.WorstCpu</td>
                                                <td>@item.InvalidMeasurementCount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- Explanation Section -->
            <div class="alert alert-info">
                <h5>Explanation</h5>
                <ul>
                    <li><strong>n:</strong> Number of elements in the array.</li>
                    <li><strong>k:</strong> The number of digits (for algorithms like Radix Sort).</li>
                    <li>
                        Arrays are tested under 3 configurations: <strong>Randomly Ordered</strong>, <strong>
                            Partially
                            Ordered
                        </strong>, and <strong>Reverse Ordered</strong>.
                    </li>
                    <li>
                        Array sizes tested: <strong>1,000</strong>, <strong>10,000</strong>, and
                        <strong>100,000</strong>.
                    </li>
                    <li>
                        Each test compares <strong>RAM usage</strong>, <strong>CPU percentage</strong>, and
                        <strong>Execution Time</strong>.
                    </li>
                    <li><strong>Execution Count:</strong> The number of times the algorithm was executed for the given configuration and array size.</li>
                    <li><strong>Best Case:</strong> Theoretical best case time complexity for the algorithm, depending on the input configuration.</li>
                    <li><strong>Average Case:</strong> Theoretical average case time complexity, assuming typical input distributions.</li>
                    <li><strong>Worst Case:</strong> Theoretical worst case time complexity, representing the algorithm's performance under the most challenging input.</li>
                    <li><strong>Invalid Measurements:</strong> Counts how many times measurements were invalid (e.g., when memory or CPU usage was zero, which is unrealistic).</li>
                </ul>
            </div>

        </div>
     
    </div>
    <div id="page-3">
        <div id="algorithms">
            <!-- For each algorithm -->
            @foreach (var algorithm in new[] { "quick", "heap", "shell", "merge", "radix" })
            {
                <div class="mb-5">
                    <h2 class="text-center text-primary">@algorithm</h2>
                    <hr>

                    <!-- Execution Time Charts -->
                    <div class="mb-4">
                        <h4>Execution Time</h4>
                        <p>Execution time measures how fast an algorithm runs. Lower values are better.</p>
                        <div class="row">
                            <div class="col-md-4">
                                <h5>1k Elements</h5>
                                <div id="chart-@algorithm-random-1k"></div>
                            </div>
                            <div class="col-md-4">
                                <h5>10k Elements</h5>
                                <div id="chart-@algorithm-random-10k"></div>
                            </div>
                            <div class="col-md-4">
                                <h5>100k Elements</h5>
                                <div id="chart-@algorithm-random-100k"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Memory Usage (RAM) Charts -->
                    <div class="mb-4">
                        <h4>Memory Usage (RAM)</h4>
                        <p>Memory usage indicates how much RAM the algorithm requires. Lower values are better.</p>
                        <div class="row">
                            <div class="col-md-4">
                                <h5>1k Elements</h5>
                                <div id="chart-@algorithm-random-memory-1k"></div>
                            </div>
                            <div class="col-md-4">
                                <h5>10k Elements</h5>
                                <div id="chart-@algorithm-random-memory-10k"></div>
                            </div>
                            <div class="col-md-4">
                                <h5>100k Elements</h5>
                                <div id="chart-@algorithm-random-memory-100k"></div>
                            </div>
                        </div>
                    </div>

                    <!-- CPU Usage Charts -->
                    <div class="mb-4">
                        <h4>CPU Usage</h4>
                        <p>CPU usage shows how much CPU the algorithm uses during execution. Lower values are better.</p>
                        <div class="row">
                            <div class="col-md-4">
                                <h5>1k Elements</h5>
                                <div id="chart-@algorithm-random-cpu-1k"></div>
                            </div>
                            <div class="col-md-4">
                                <h5>10k Elements</h5>
                                <div id="chart-@algorithm-random-cpu-10k"></div>
                            </div>
                            <div class="col-md-4">
                                <h5>100k Elements</h5>
                                <div id="chart-@algorithm-random-cpu-100k"></div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

    <button id="download-invoice" class="btn btn-primary">Download PDF</button>


</body>
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/2.4.0/purify.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"
    integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg=="
    crossorigin="anonymous" referrerpolicy="no-referrer"></script>


<script>
        window.onload = function () {
        document.getElementById('download-invoice').addEventListener('click', function () {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            const pages = ['page-1', 'page-2'];

            pages.forEach((pageId, index) => {
                const pageElement = document.getElementById(pageId);

                // 1 saniye beklemek, içeriklerin yüklenmesi için daha fazla zaman tanıyacaktır
                setTimeout(function () {
                    html2canvas(pageElement, {
                        scale: 1,
                        useCORS: true,
                        logging: true,
                    }).then((canvas) => {
                        const imgData = canvas.toDataURL('image/png');

                        if (index > 0) {
                            doc.addPage();
                        }

                        const pageWidth = doc.internal.pageSize.width;
                        const pageHeight = doc.internal.pageSize.height;
                        const imgHeight = canvas.height * pageWidth / canvas.width;

                        doc.addImage(imgData, 'PNG', 0, 0, pageWidth, imgHeight);

                        // PDF'in son sayfası render edildikten sonra kaydedilir
                        if (index === pages.length - 1) {
                            doc.save('Algo_Report.pdf');
                        }
                    });
                }, 1000);  // 1 saniye bekleme
            });
        });
    };

</script>
<script>
    console.log(@Html.Raw(Json.Serialize(ViewBag.quickSortRandom1kExecutionTime)));

    // Example JS for Quick Sort - Random Array - 1k Elements Execution Time Chart
    var quickSortRandom1kExecutionTime = {
        chart: { type: 'line' },
        series: [{
            name: 'Execution Time',
            data: @Html.Raw(Json.Serialize(ViewBag.quickSortRandom1kExecutionTime))
        }],
        title: { text: 'Quick Sort - Random Array - 1k Elements - Execution Time' },
        subtitle: { text: 'Lower values are better. Measures the time taken by the algorithm to complete.' }
    };
    new ApexCharts(document.querySelector("#chart-quick-random-1k"), quickSortRandom1kExecutionTime).render();

    // Repeat similar scripts for all other charts
</script>


</html>
