    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var jsonData = JSON.parse('@Html.Raw(ViewBag.JsonData)');
            // console.log("JSON Data:", jsonData);

            var algorithms = ["random", "partially", "reverse"];
            var sizes = ["1k", "10k", "100k"];

            algorithms.forEach(function (algorithm) {
                sizes.forEach(function (size) {
                    var filteredData = jsonData.filter(data =>
                        data.ArrayType.toLowerCase() === algorithm &&
                        data.ArraySize === size.replace("k", "000")
                    );

                    // console.log(`Filtered Data for ${algorithm} (${size}):`, filteredData);

                    if (filteredData.length > 0) {
                        try {
                            // Memory Usage
                            var memorySeries = [
                                { name: 'Best', data: filteredData.map(data => parseFloat(data.BestMemory)) },
                                { name: 'Worst', data: filteredData.map(data => parseFloat(data.WorstMemory)) },
                                { name: 'Average', data: filteredData.map(data => parseFloat(data.AverageMemory)) }
                            ];
                            renderChart(`${algorithm.replace(" ", "-")}-sorted-memory-${size}`, memorySeries, filteredData.map(data => data.Algorithm), "MB");

                            // CPU Usage
                            var cpuSeries = [
                                { name: 'Best', data: filteredData.map(data => parseFloat(data.BestCpu)) },
                                { name: 'Worst', data: filteredData.map(data => parseFloat(data.WorstCpu)) },
                                { name: 'Average', data: filteredData.map(data => parseFloat(data.AverageCpu)) }
                            ];
                            renderChart(`${algorithm.replace(" ", "-")}-sorted-cpu-${size}`, cpuSeries, filteredData.map(data => data.Algorithm), "%");

                            // Execution Time
                            var timeSeries = [
                                { name: 'Best', data: filteredData.map(data => parseFloat(data.BestTime)) },
                                { name: 'Worst', data: filteredData.map(data => parseFloat(data.WorstTime)) },
                                { name: 'Average', data: filteredData.map(data => parseFloat(data.AverageTime)) }
                            ];
                            renderChart(`${algorithm.replace(" ", "-")}-sorted-execution-${size}`, timeSeries, filteredData.map(data => data.Algorithm), "ms");
                        } catch (error) {
                            console.error(`Error rendering chart for ${algorithm} (${size}):`, error);
                        }
                    } else {
                        console.warn(`No data found for ${algorithm} (${size})`);
                    }
                });
            });

            // Grafik oluşturma fonksiyonu
            function renderChart(id, series, categories, unit) {
                var options = {
                    series: series,
                    chart: {
                        type: 'bar',
                        height: 350
                    },
                    xaxis: {
                        categories: categories
                    },
                    yaxis: {
                        title: {
                            text: unit
                        }
                    },
                    tooltip: {
                        y: {
                            formatter: function (val) {
                                return val + " " + unit;
                            }
                        }
                    }
                };

                var element = document.querySelector(`#${id}`);
                if (element) {
                    var chart = new ApexCharts(element, options);
                    chart.render();
                } else {
                    console.error(`Element with ID '${id}' not found`);
                }
            }
        });
    </script>
