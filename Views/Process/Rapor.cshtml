@model List<algo.ViewModels.AlgorithmReportViewModel>


@{
    ViewData["Title"] = "Sorting Algorithms Detailed Report";
}


<div id="page-1">

    <div class="container my-5">
        <h1 class="text-center mb-4">Sorting Algorithms Detailed Performance Report</h1>
        <p class="text-muted text-center">
            This report compares theoretical and experimental performance of sorting algorithms under different
            array
            configurations.
        </p>
        <div class="table-responsive">
            <div class="tabs">
                <!-- Tab Menüsü -->
                <ul class="nav nav-tabs" id="arrayTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="tab-1k" data-bs-toggle="tab" href="#array-1k" role="tab"
                           aria-controls="array-1k" aria-selected="true">1K</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="tab-10k" data-bs-toggle="tab" href="#array-10k" role="tab"
                           aria-controls="array-10k" aria-selected="false">10K</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="tab-100k" data-bs-toggle="tab" href="#array-100k" role="tab"
                           aria-controls="array-100k" aria-selected="false">100K</a>
                    </li>
                </ul>

                <!-- Tab İçerikleri -->
                <div class="tab-content mt-3" id="arrayTabsContent">
                    <div class="tab-pane fade show active" id="array-1k" role="tabpanel" aria-labelledby="tab-1k">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped text-center">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Algorithm</th>
                                        <th>Array Type</th>
                                        <th>Execution Count</th>
                                        <th>Theoretical Best Case</th>
                                        <th>Theoretical Average Case</th>
                                        <th>Theoretical Worst Case</th>
                                        <th>Average Time (ms)</th>
                                        <th>Best Time (ms)</th>
                                        <th>Worst Time (ms)</th>
                                        <th>Average Memory (MB)</th>
                                        <th>Best Memory (MB)</th>
                                        <th>Worst Memory (MB)</th>
                                        <th>Average CPU (%)</th>
                                        <th>Best CPU (%)</th>
                                        <th>Worst CPU (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(m => m.ArraySize == "1000"))
                                    {
                                        <tr>
                                            <td>@item.Algorithm</td>
                                            <td>@item.ArrayType</td>
                                            <td>@item.ExecutionCount</td>
                                            <td>@item.TheoreticalBestCase</td>
                                            <td>@item.TheoreticalAverageCase</td>
                                            <td>@item.TheoreticalWorstCase</td>
                                            <td>@item.AverageTime</td>
                                            <td>@item.BestTime</td>
                                            <td>@item.WorstTime</td>
                                            <td>@item.AverageMemory</td>
                                            <td>@item.BestMemory</td>
                                            <td>@item.WorstMemory</td>
                                            <td>@item.AverageCpu</td>
                                            <td>@item.BestCpu</td>
                                            <td>@item.WorstCpu</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="array-10k" role="tabpanel" aria-labelledby="tab-10k">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped text-center">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Algorithm</th>
                                        <th>Array Type</th>
                                        <th>Execution Count</th>
                                        <th>Theoretical Best Case</th>
                                        <th>Theoretical Average Case</th>
                                        <th>Theoretical Worst Case</th>
                                        <th>Average Time (ms)</th>
                                        <th>Best Time (ms)</th>
                                        <th>Worst Time (ms)</th>
                                        <th>Average Memory (MB)</th>
                                        <th>Best Memory (MB)</th>
                                        <th>Worst Memory (MB)</th>
                                        <th>Average CPU (%)</th>
                                        <th>Best CPU (%)</th>
                                        <th>Worst CPU (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(m => m.ArraySize == "10000"))
                                    {
                                        <tr>
                                            <td>@item.Algorithm</td>
                                            <td>@item.ArrayType</td>
                                            <td>@item.ExecutionCount</td>
                                            <td>@item.TheoreticalBestCase</td>
                                            <td>@item.TheoreticalAverageCase</td>
                                            <td>@item.TheoreticalWorstCase</td>
                                            <td>@item.AverageTime</td>
                                            <td>@item.BestTime</td>
                                            <td>@item.WorstTime</td>
                                            <td>@item.AverageMemory</td>
                                            <td>@item.BestMemory</td>
                                            <td>@item.WorstMemory</td>
                                            <td>@item.AverageCpu</td>
                                            <td>@item.BestCpu</td>
                                            <td>@item.WorstCpu</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="array-100k" role="tabpanel" aria-labelledby="tab-100k">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped text-center">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Algorithm</th>
                                        <th>Array Type</th>
                                        <th>Execution Count</th>
                                        <th>Theoretical Best Case</th>
                                        <th>Theoretical Average Case</th>
                                        <th>Theoretical Worst Case</th>
                                        <th>Average Time (ms)</th>
                                        <th>Best Time (ms)</th>
                                        <th>Worst Time (ms)</th>
                                        <th>Average Memory (MB)</th>
                                        <th>Best Memory (MB)</th>
                                        <th>Worst Memory (MB)</th>
                                        <th>Average CPU (%)</th>
                                        <th>Best CPU (%)</th>
                                        <th>Worst CPU (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(m => m.ArraySize == "100000"))
                                    {
                                        <tr>
                                            <td>@item.Algorithm</td>
                                            <td>@item.ArrayType</td>
                                            <td>@item.ExecutionCount</td>
                                            <td>@item.TheoreticalBestCase</td>
                                            <td>@item.TheoreticalAverageCase</td>
                                            <td>@item.TheoreticalWorstCase</td>
                                            <td>@item.AverageTime</td>
                                            <td>@item.BestTime</td>
                                            <td>@item.WorstTime</td>
                                            <td>@item.AverageMemory</td>
                                            <td>@item.BestMemory</td>
                                            <td>@item.WorstMemory</td>
                                            <td>@item.AverageCpu</td>
                                            <td>@item.BestCpu</td>
                                            <td>@item.WorstCpu</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- Explanation Section -->
        <div class="alert alert-info">
            <h5>Explanation</h5>
            <ul>
                <li><strong>n:</strong> Number of elements in the array.</li>
                <li><strong>k:</strong> The number of digits (for algorithms like Radix Sort).</li>
                <li>
                    Arrays are tested under 3 configurations: <strong>Randomly Ordered</strong>, <strong>
                        Partially
                        Ordered
                    </strong>, and <strong>Reverse Ordered</strong>.
                </li>
                <li>
                    Array sizes tested: <strong>1,000</strong>, <strong>10,000</strong>, and
                    <strong>100,000</strong>.
                </li>
                <li>
                    Each test compares <strong>RAM usage</strong>, <strong>CPU percentage</strong>, and
                    <strong>Execution Time</strong>.
                </li>
                <li>
                    <strong>Execution Count:</strong> The number of times the algorithm was executed for the given
                    configuration and array size.
                </li>
                <li>
                    <strong>Best Case:</strong> Theoretical best case time complexity for the algorithm, depending
                    on the input configuration.
                </li>
                <li>
                    <strong>Average Case:</strong> Theoretical average case time complexity, assuming typical input
                    distributions.
                </li>
                <li>
                    <strong>Worst Case:</strong> Theoretical worst case time complexity, representing the
                    algorithm's performance under the most challenging input.
                </li>
                <li>
                    <strong>Invalid Measurements:</strong> Counts how many times measurements were invalid (e.g.,
                    when memory or CPU usage was zero, which is unrealistic).
                </li>
            </ul>
        </div>

    </div>

</div>
