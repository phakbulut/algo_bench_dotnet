@{
    ViewBag.Title = "Sonuç";
}

@section Styles {
    <style>
        .result-container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 20px;
        }

        .array-display {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin: 10px 0;
            font-family: monospace;
            max-height: 100px;
            overflow-x: auto;
            overflow-y: hidden;
            white-space: nowrap;
            scrollbar-width: thin;
        }
            .array-display::-webkit-scrollbar {
                height: 8px;
            }

            .array-display::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 4px;
            }

            .array-display::-webkit-scrollbar-thumb {
                background: #888;
                border-radius: 4px;
            }

                .array-display::-webkit-scrollbar-thumb:hover {
                    background: #555;
                }

        .card {
            margin-bottom: 20px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .table {
            margin-bottom: 0;
        }

        .metric-value {
            font-weight: 500;
            color: #2c3e50;
        }

        .table th {
            background-color: #f8f9fa;
        }

        .average-metrics {
            background-color: #e9ecef;
            padding: 15px;
            border-radius: 5px;
            margin-top: 20px;
        }
    </style>
}
<div class="result-container">
    <h2 class="mb-4">Algorith Result</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h3 class="card-title">Algoritma: <span class="metric-value">@ViewBag.Algorithm</span></h3>
            <div class="row">
                <div class="col-md-4">
                    <p>Array Type: <span class="metric-value">@ViewBag.ArrayType</span></p>
                </div>
                <div class="col-md-4">
                    <p>Array Size: <span class="metric-value">@ViewBag.ArraySize</span></p>
                </div>
                <div class="col-md-4">
                    <p>Time Taken: <span class="metric-value">@ViewBag.TimeTaken ms</span></p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4 class="card-title">Original Array:</h4>
            <div class="array-display">
                @string.Join(", ", ViewBag.OriginalArray)
            </div>

            <h4 class="card-title mt-4">Sorted Array:</h4>
            <div class="array-display">
                @string.Join(", ", ViewBag.SortedArray)
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h3 class="card-title mb-4">Resource Usage</h3>

            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Time (s)</th>
                            <th>Memory (MB)</th>
                            <th>CPU Usage (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usage in ViewBag.ResourceUsage)
                        {
                            <tr>
                                <td>@usage.Item1</td>
                                <td>@string.Format("{0:F6}", usage.Item2)</td>
                                <td>@usage.Item3</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="average-metrics mt-4">
                <h4 class="mb-3">Average Resource Usage</h4>
                <div class="row">
                    <div class="col-md-4">
                        <p>Time (s): <span class="metric-value">@string.Format("{0:F6}", ViewBag.AverageTime)</span></p>
                    </div>
                    <div class="col-md-4">
                        <p>Memory (MB): <span class="metric-value">@string.Format("{0:F6}", ViewBag.AverageMemory)</span></p>
                    </div>
                    <div class="col-md-4">
                        <p>CPU Usage (%): <span class="metric-value">@string.Format("{0:F6}", ViewBag.AverageCpu)</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>